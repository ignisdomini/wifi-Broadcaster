# Пример файла с ключом подписи. Скопируйте в keystore.properties и заполните
# своими значениями — настоящий файл в репозиторий не попадает.
#
# Ключ создаётся так:
#   keytool -genkeypair -v -keystore my-release.jks -alias my-alias \
#           -keyalg RSA -keysize 4096 -validity 10950
#
# Без этого файла release собирается неподписанным: сборка не падает у того,
# у кого ключа и не должно быть.
storeFile=my-release.jks
storePassword=пароль-хранилища
keyAlias=my-alias
keyPassword=пароль-ключа
