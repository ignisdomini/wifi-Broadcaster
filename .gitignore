# --- Секреты. Никогда не попадают в репозиторий -----------------------------
# Ключ подписи и пароль к нему: утечка означает, что кто угодно выпустит
# обновление, которое телефоны примут как настоящее.
android/keystore.properties
*.jks
*.keystore

# Путь к Android SDK — у каждого свой.
android/local.properties

# Доступ к базе и соль для отпечатков IP: создаётся установщиком.
site/config.php

# --- Сборка и артефакты ----------------------------------------------------
build/
.gradle/
.cxx/
captures/
*.apk
*.aab
*.ap_
*.dex

# Сборка приложения, которую раздаёт сайт: одиннадцать мегабайт на каждый
# выпуск. Место ей в релизах, а не в истории.
site/app/

# Каталог загрузок остался от версий с картинками; файлы больше не принимаются.
site/uploads/

# --- Среды разработки ------------------------------------------------------
.idea/
.vscode/
*.iml
*.log
.DS_Store
Thumbs.db
